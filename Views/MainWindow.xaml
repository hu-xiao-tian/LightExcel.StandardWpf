<Window x:Class="LightExcel.StandardWpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LightExcel · 功能测试台" Height="920" Width="1540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource LightExcel.Surface}"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <!-- 左侧导航项：选中态用浅色底 + 左侧强调条，鼠标悬停单独一档 -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="10" Background="Transparent" />
                            <Border x:Name="AccentBar" Width="3" Height="16" CornerRadius="2" Opacity="0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource LightExcel.Accent}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#10FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF" />
                                <Setter TargetName="AccentBar" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource LightExcel.Accent}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource LightExcel.Text}" />
                                <TextBlock Text="{Binding Description}" FontSize="10.5" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource LightExcel.Muted}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= 左侧导航 ================= -->
        <Border Grid.Column="0"
                Background="#0CFFFFFF"
                BorderBrush="{DynamicResource LightExcel.Border}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20,14,16">
                <!-- 品牌 -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="9" Background="#263B82F6">
                        <TextBlock Text="▦" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource LightExcel.Accent}" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LightExcel" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource LightExcel.Text}" />
                        <TextBlock Text="功能测试台" FontSize="10.5"
                                   Foreground="{DynamicResource LightExcel.Muted}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 底栏：数据源信息 -->
                <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="10,10,10,2"
                        BorderBrush="{DynamicResource LightExcel.Border}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="本地 SQLite" FontSize="10" Foreground="{DynamicResource LightExcel.Muted}" />
                        <TextBlock Text="{Binding DatabaseName}" FontSize="11" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource LightExcel.Text}" />
                    </StackPanel>
                </Border>

                <!-- 导航列表 -->
                <ListBox x:Name="NavList"
                         ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         Background="Transparent" BorderThickness="0"
                         Margin="0,20,0,0"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
        </Border>

        <!-- ================= 内容区 ================= -->
        <DockPanel Grid.Column="1" Margin="28,22,28,24">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="{Binding PageTitle}" FontSize="21" FontWeight="SemiBold"
                           Foreground="{DynamicResource LightExcel.Text}" />
                <TextBlock Text="{Binding PageDescription}" FontSize="12" Margin="0,5,0,0"
                           Foreground="{DynamicResource LightExcel.Muted}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 页面实例由外壳缓存，切换只换引用，表格筛选和滚动位置都保留 -->
            <ContentControl x:Name="PageHost" Content="{Binding CurrentContent}" Focusable="False" />
        </DockPanel>
    </Grid>
</Window>
