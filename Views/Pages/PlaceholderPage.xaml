<UserControl x:Class="LightExcel.StandardWpf.Views.Pages.PlaceholderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border MaxWidth="820" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="#08FFFFFF" BorderBrush="{DynamicResource LightExcel.Border}"
                BorderThickness="1" CornerRadius="12" Padding="32,28">
            <StackPanel>
                <Border Width="44" Height="44" CornerRadius="12" Background="#1A3B82F6" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Glyph}" FontSize="22" Foreground="{DynamicResource LightExcel.Accent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="这个位置留给你下一个功能测试" FontSize="19" FontWeight="SemiBold"
                           Foreground="{DynamicResource LightExcel.Text}" Margin="0,18,0,0" />
                <TextBlock Text="页面框架已经就绪：导航、内容区、页面缓存都做好了。新增一个测试页不需要改外壳代码。"
                           Foreground="{DynamicResource LightExcel.Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" />

                <Border Height="1" Background="{DynamicResource LightExcel.Border}" Margin="0,22,0,22" />

                <TextBlock Text="三步接入" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource LightExcel.Text}" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="20" Height="20" CornerRadius="10" Background="#1FFFFFFF" VerticalAlignment="Top">
                        <TextBlock Text="1" FontSize="11" Foreground="{DynamicResource LightExcel.Text}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Foreground="{DynamicResource LightExcel.Muted}" FontSize="13" TextWrapping="Wrap"
                               Text="在 Views/Pages 下新建 XxxPage.xaml（UserControl），把测试用的控件摆进去。" />
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="20" Height="20" CornerRadius="10" Background="#1FFFFFFF" VerticalAlignment="Top">
                        <TextBlock Text="2" FontSize="11" Foreground="{DynamicResource LightExcel.Text}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Foreground="{DynamicResource LightExcel.Muted}" FontSize="13" TextWrapping="Wrap"
                               Text="让 code-behind 实现 ITestPage（提供 Title / Description / Glyph），构造函数里设置自己的 DataContext。" />
                </Grid>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="20" Height="20" CornerRadius="10" Background="#1FFFFFFF" VerticalAlignment="Top">
                        <TextBlock Text="3" FontSize="11" Foreground="{DynamicResource LightExcel.Text}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Foreground="{DynamicResource LightExcel.Muted}" FontSize="13" TextWrapping="Wrap"
                               Text="在 App.xaml.cs 的 OnStartup 里注册。页面实例会被缓存，切走再切回不会丢状态。" />
                </Grid>

                <Border Background="#0AFFFFFF" BorderBrush="{DynamicResource LightExcel.Border}"
                        BorderThickness="1" CornerRadius="8" Padding="16,12">
                    <TextBox Text="{Binding Snippet, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                             Background="Transparent" Foreground="{DynamicResource LightExcel.Accent}"
                             FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12.5"
                             TextWrapping="NoWrap" AcceptsReturn="True" IsTabStop="False" />
                </Border>

                <TextBlock Foreground="{DynamicResource LightExcel.Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0"
                           Text="提示：这个模板页本身也可以当参照，OrdersPage 是更完整的例子（带 ViewModel、表格事件与释放逻辑）。" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
