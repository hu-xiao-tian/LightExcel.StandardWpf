<UserControl x:Class="LightExcel.StandardWpf.Views.Pages.OrdersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:sheet="http://schemas.lightexcel.dev/wpf"
             FontFamily="Microsoft YaHei UI, Segoe UI">
    <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource LightExcel.ButtonStyle}"/>
    </UserControl.Resources>
    <DockPanel>
        <!-- 第一行：数据加载与文件导入导出 -->
        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Style="{DynamicResource LightExcel.PrimaryButtonStyle}" Content="加载数据库订单" Command="{Binding LoadCommand}" Padding="12,5" Margin="0,0,8,4" />
            <Button Style="{DynamicResource LightExcel.ButtonStyle}" Content="清空" Command="{Binding ClearCommand}" Padding="10,5" Margin="0,0,12,4" />
            <Button Content="导入 Excel" Command="{Binding ImportCommand}"
                    ToolTip="用文件中的全部订单替换源数据，保留当前筛选条件。"
                    Padding="10,5" Margin="0,0,8,4" />
            <Button Content="导出当前视图" Command="{Binding ExportCommand}"
                    ToolTip="将当前筛选结果按表格顺序导出为 Excel，包含屏幕外符合条件的行。"
                    CommandParameter="{Binding ElementName=Sheet}" Padding="10,5" Margin="0,0,8,4" />
            <Button Content="导出全部源数据" Command="{Binding ExportSourceCommand}"
                    ToolTip="按原始集合顺序导出所有已加载或导入的订单。"
                    Padding="10,5" Margin="0,0,12,4" />
            <Button Content="清空筛选" Click="ClearFilter_Click"
                    ToolTip="清除所有列的筛选条件，恢复全量视图。"
                    Padding="10,5" Margin="0,0,8,4" />
            <Button Content="列设置" Click="OpenColumnSettings_Click"
                    ToolTip="直接打开列显示/隐藏与列顺序重置面板。"
                    Padding="10,5" Margin="0,0,14,4" />
            <TextBlock Foreground="{DynamicResource LightExcel.Text}" Text="{Binding Status}" VerticalAlignment="Center" Margin="0,0,0,4" />
        </WrapPanel>

        <!-- 第二行：全功能实时演示开关 -->
        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="ReadOnlyToggle" Style="{DynamicResource LightExcel.CheckBoxStyle}" Content="只读·整行" IsChecked="{Binding IsReadOnly, ElementName=Sheet, Mode=TwoWay}" ToolTip="取消勾选进入单元格编辑模式（双击或 F2 编辑，Ctrl+Z 撤销）。" VerticalAlignment="Center" Margin="0,0,12,4" />
            <CheckBox x:Name="SelectionEnabledToggle" Style="{DynamicResource LightExcel.CheckBoxStyle}" Content="允许选中" IsChecked="{Binding IsSelectionEnabled, ElementName=Sheet, Mode=TwoWay}" ToolTip="关闭后禁止选中行/单元格并清除蓝色高亮，不影响滚动、排序、筛选与自定义右键菜单。" VerticalAlignment="Center" Margin="0,0,12,4" />
            <CheckBox x:Name="MultipleRowsToggle" Style="{DynamicResource LightExcel.CheckBoxStyle}" Content="多选行"
                      IsEnabled="{Binding IsReadOnly, ElementName=Sheet}"
                      IsChecked="{Binding CanSelectMultipleRows, ElementName=Sheet, Mode=TwoWay}" ToolTip="只读模式下启用 Ctrl 跳选与 Shift 连选。" VerticalAlignment="Center" Margin="0,0,12,4" />
            <CheckBox Style="{DynamicResource LightExcel.CheckBoxStyle}" Content="复制粘贴" IsChecked="{Binding CanUserCopyPaste, ElementName=Sheet, Mode=TwoWay}" ToolTip="开启后支持 Ctrl+C/V 并在数据行右键菜单显示「复制/粘贴」；关闭后从菜单移除。" VerticalAlignment="Center" Margin="0,0,12,4" />
            <CheckBox Style="{DynamicResource LightExcel.CheckBoxStyle}" Content="排序" IsChecked="{Binding CanUserSortColumns, ElementName=Sheet, Mode=TwoWay}" ToolTip="开启后左键点击叶列表头排序。" VerticalAlignment="Center" Margin="0,0,12,4" />
            <CheckBox Style="{DynamicResource LightExcel.CheckBoxStyle}" Content="筛选" IsChecked="{Binding CanUserFilterColumns, ElementName=Sheet, Mode=TwoWay}" ToolTip="开启后右键列头菜单显示「筛选此列」；关闭后从菜单移除。" VerticalAlignment="Center" Margin="0,0,12,4" />
            <CheckBox Style="{DynamicResource LightExcel.CheckBoxStyle}" Content="列设置菜单" IsChecked="{Binding CanUserHideColumns, ElementName=Sheet, Mode=TwoWay}" ToolTip="开启后右键列头菜单显示「列设置」；关闭后从菜单移除。" VerticalAlignment="Center" Margin="0,0,12,4" />
            <CheckBox Style="{DynamicResource LightExcel.CheckBoxStyle}" Content="拖列" IsChecked="{Binding CanUserReorderColumns, ElementName=Sheet, Mode=TwoWay}" ToolTip="允许拖动表头调整列顺序。" VerticalAlignment="Center" Margin="0,0,12,4" />
            <CheckBox Style="{DynamicResource LightExcel.CheckBoxStyle}" Content="调宽" IsChecked="{Binding CanUserResizeColumns, ElementName=Sheet, Mode=TwoWay}" ToolTip="允许拖动表头边界调整列宽。" VerticalAlignment="Center" Margin="0,0,12,4" />
            <CheckBox Style="{DynamicResource LightExcel.CheckBoxStyle}" Content="行号" IsChecked="{Binding ShowRowNumbers, ElementName=Sheet, Mode=TwoWay}" ToolTip="显示或隐藏左侧自动行号列。" VerticalAlignment="Center" Margin="0,0,12,4" />
            <CheckBox Style="{DynamicResource LightExcel.CheckBoxStyle}" Content="查找(Ctrl+F)" IsChecked="{Binding CanUserFind, ElementName=Sheet, Mode=TwoWay}" ToolTip="启用 Ctrl+F 按列查找悬浮框。" VerticalAlignment="Center" Margin="0,0,12,4" />
            <CheckBox Style="{DynamicResource LightExcel.CheckBoxStyle}" Content="查询索引" IsChecked="{Binding IsIndexEnabled, ElementName=Sheet, Mode=TwoWay}" ToolTip="允许按需构建查询索引加速反复筛选。" VerticalAlignment="Center" Margin="0,0,12,4" />
            <CheckBox x:Name="LightThemeToggle" Style="{DynamicResource LightExcel.CheckBoxStyle}" Content="浅色主题" Checked="ThemeToggle_Changed" Unchecked="ThemeToggle_Changed" ToolTip="切换表格深色/浅色主题（标准右键菜单同步跟随换肤）。" VerticalAlignment="Center" Margin="0,0,14,4" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                <TextBlock Text="冻结列：" Foreground="{DynamicResource LightExcel.Muted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox x:Name="FrozenCombo" Width="58" SelectedIndex="2" SelectionChanged="FrozenCombo_SelectionChanged" VerticalAlignment="Center">
                    <ComboBoxItem Content="0" />
                    <ComboBoxItem Content="1" />
                    <ComboBoxItem Content="2" />
                    <ComboBoxItem Content="3" />
                </ComboBox>
            </StackPanel>
        </WrapPanel>

        <!-- 第三行：数据区合并与代码公式合并演示 -->
        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="AutoMergeToggle" Style="{DynamicResource LightExcel.CheckBoxStyle}" Content="自动合并指定列"
                      IsChecked="{Binding IsAutoMergeEnabled, ElementName=Sheet, Mode=TwoWay}"
                      ToolTip="合并已配置列中相邻的相同值。" VerticalAlignment="Center" Margin="0,0,12,4" />
            <CheckBox x:Name="ManualMergeToggle" Style="{DynamicResource LightExcel.CheckBoxStyle}" Content="允许手动合并"
                      IsChecked="{Binding IsManualMergeEnabled, ElementName=Sheet, Mode=TwoWay}"
                      ToolTip="取消只读后在单元格模式下框选，通过右键菜单合并/取消合并。" VerticalAlignment="Center" Margin="0,0,12,4" />
            <CheckBox x:Name="BlockCrossTypeMergeToggle" Style="{DynamicResource LightExcel.CheckBoxStyle}" Content="禁止跨类型合并"
                      ToolTip="演示 CellsMerging 自定义校验钩子：勾选后跨不同字段类型（如客户编码 string + 交货日期 DateTime）时右键「合并单元格」将自动置灰拦截。" VerticalAlignment="Center" Margin="0,0,12,4" />
            <Button Content="代码合并·求和" Click="ApplyComputedMerge_Click"
                    ToolTip="按同客户自动合并并实时显示展开长合计（Sum）与订单条数（Compute），不改底层明细。"
                    Padding="10,5" Margin="0,0,8,4" />
            <Button Content="二维 Grid 合并" Click="ApplyGridMerge_Click"
                    ToolTip="对客户行业与客户名称执行横纵同值二维矩形合并（杜绝梯形/L形）。"
                    Padding="10,5" Margin="0,0,8,4" />
            <Button Content="清除代码合并" Click="ClearConfiguredMerge_Click"
                    ToolTip="清除通过代码配置的合并规则。"
                    Padding="10,5" Margin="0,0,8,4" />
            <Button Content="导出合并视图" Command="{Binding ExportMergedCommand}" CommandParameter="{Binding ElementName=Sheet}" Padding="10,5" Margin="0,0,0,4">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource LightExcel.ButtonStyle}">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsAutoMergeEnabled, ElementName=Sheet}" Value="False" />
                                    <Condition Binding="{Binding IsManualMergeEnabled, ElementName=Sheet}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsEnabled" Value="False" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </WrapPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="读取选中行数据" Command="{Binding ReadSelectedOrdersCommand}"
                        Padding="12,6" Margin="12,0,0,0" />
                <TextBlock Foreground="{DynamicResource LightExcel.Text}" VerticalAlignment="Center">
                <Run Text="选中订单：" /><Run Text="{Binding SelectedOrder.OrderNo, Mode=OneWay, FallbackValue=未选中, TargetNullValue=未选中}" />
                <Run Text="　已选行数：" /><Run Text="{Binding SelectedOrders.Count, Mode=OneWay, FallbackValue=0}" />
                <Run Text="　显示行索引：" /><Run Text="{Binding SelectedOrderIndex, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>

            <TextBlock Text="{Binding SelectedOrdersPreview}" Foreground="{DynamicResource LightExcel.Muted}"
                       TextWrapping="Wrap" Margin="0,0,0,6" />

            <TextBlock x:Name="QueryStatus" Foreground="{DynamicResource LightExcel.Text}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Engine.ClipboardError, ElementName=Sheet, TargetNullValue=''}" Foreground="#FFB4AB" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Foreground="{DynamicResource LightExcel.Muted}" Text="Ctrl＋单击跳选，Shift 连选；关闭“允许多选行”恢复单选。表格左侧两列已固定，可横向滚动查看。只读列可复制，不能编辑或粘贴；编辑仅修改内存，不自动保存数据库。" />
        </StackPanel>

        <Border Background="{DynamicResource LightExcel.Surface}" BorderBrush="{DynamicResource LightExcel.Border}" BorderThickness="1" CornerRadius="10" Padding="1">
            <sheet:SpreadsheetVisual CanUserCopyPaste="False"  CanUserHideColumns="True"  x:Name="Sheet" IsLayoutPersistenceEnabled="True" ItemsSource="{Binding SourceOrders}" Headers="{Binding OrderHeaders}"
                                     ViewItems="{Binding ViewOrders, Mode=OneWayToSource}" 
                                     ViewChangedMethod="OnOrdersViewChanged" MergeKeyPath="OrderNo"
                                     CanSelectMultipleRows="True" SelectedItems="{Binding SelectedOrders, Mode=OneWayToSource}"
                                     SelectedItem="{Binding SelectedOrder}" SelectedIndex="{Binding SelectedOrderIndex}" IsReadOnly="True"
                                     FrozenColumnCount="2" CornerRadius="9"  CanUserSortColumns="True"
                                     CanUserFilterColumns="True">
                <sheet:SpreadsheetVisual.ColumnHeaderContextMenu>
                    <ContextMenu>
                        <MenuItem Header="重命名列" Command="{Binding RenameColumn}"
                                  CommandParameter="{Binding PlacementTarget.RightClickedColumn, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="导出当前视图" Command="{Binding ExportCommand}"
                                  CommandParameter="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </sheet:SpreadsheetVisual.ColumnHeaderContextMenu>
                <sheet:SpreadsheetVisual.RowContextMenu>
                    <ContextMenu>
                        <MenuItem Header="预览标签" Command="{Binding PreviewReceipt}"
                                  CommandParameter="{Binding PlacementTarget.RightClickedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="打印标签" Command="{Binding PrintReceipt}"
                                  CommandParameter="{Binding PlacementTarget.RightClickedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="手动打印" Command="{Binding HandPrintReceipt}"
                                  CommandParameter="{Binding PlacementTarget.RightClickedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </sheet:SpreadsheetVisual.RowContextMenu>
                <sheet:SpreadsheetVisual.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Height" Value="34" />
                        <Setter Property="FontSize" Value="14" />
                    </Style>
                </sheet:SpreadsheetVisual.ColumnHeaderStyle>
                <sheet:SpreadsheetVisual.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="27" />
                        <Setter Property="FontSize" Value="15" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Priority}" Value="低">
                                <Setter Property="Foreground" Value="#56B4FF" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Priority}" Value="普通">
                                <Setter Property="Foreground" Value="#FFD166" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Priority}" Value="加急">
                                <Setter Property="Foreground" Value="#FF6B6B" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </sheet:SpreadsheetVisual.RowStyle>
                <sheet:SpreadsheetVisual.ColumnStyles>
                    <!-- 方式 1（纯 XAML）：紧挨着 RowStyle，x:Key 写字段名或列标题即可 -->
                    <Style x:Key="OrderStatus" TargetType="TextBlock">
                        <Setter Property="TextAlignment" Value="Center" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OrderStatus}" Value="已完成">
                                <Setter Property="Foreground" Value="#22C55E" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OrderStatus}" Value="生产中">
                                <Setter Property="Foreground" Value="#FB923C" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OrderStatus}" Value="已排产">
                                <Setter Property="Foreground" Value="#C084FC" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OrderStatus}" Value="待排产">
                                <Setter Property="Foreground" Value="#FF4D6D" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </sheet:SpreadsheetVisual.ColumnStyles>
                <sheet:SpreadsheetVisual.SummaryRowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="45" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="Foreground" Value="#F1F8FF" />
                    </Style>
                </sheet:SpreadsheetVisual.SummaryRowStyle>
            </sheet:SpreadsheetVisual>
        </Border>
    </DockPanel>
</UserControl>
