<UserControl x:Class="LightExcel.StandardWpf.Views.Pages.LruPagingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sheet="http://schemas.lightexcel.dev/wpf"
             FontFamily="Microsoft YaHei UI, Segoe UI">
    <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource LightExcel.ButtonStyle}" />
    </UserControl.Resources>
    <DockPanel>
        <!-- 第一行：纯 MVVM 绑定数据规模、LRU 常驻页上限、模拟后端延迟 -->
        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="虚拟总行数：" Foreground="{DynamicResource LightExcel.Muted}" VerticalAlignment="Center" Margin="0,0,6,4" />
            <ComboBox Style="{DynamicResource LightExcel.ComboBoxStyle}" Width="125" Margin="0,0,14,4"
                      ItemsSource="{Binding RowScaleOptions}" SelectedItem="{Binding SelectedRowScale}" />

            <TextBlock Text="LRU 最大常驻页：" Foreground="{DynamicResource LightExcel.Muted}" VerticalAlignment="Center" Margin="0,0,6,4" />
            <ComboBox Style="{DynamicResource LightExcel.ComboBoxStyle}" Width="125" Margin="0,0,14,4"
                      ItemsSource="{Binding MaxPagesOptions}" SelectedItem="{Binding SelectedMaxPages}" />

            <TextBlock Text="模拟后端 I/O：" Foreground="{DynamicResource LightExcel.Muted}" VerticalAlignment="Center" Margin="0,0,6,4" />
            <ComboBox Style="{DynamicResource LightExcel.ComboBoxStyle}" Width="120" Margin="0,0,14,4"
                      ItemsSource="{Binding DelayOptions}" SelectedItem="{Binding SelectedDelay}" />

            <Button Style="{DynamicResource LightExcel.PrimaryButtonStyle}" Content="重建 LRU 分页会话"
                    Command="{Binding RebuildCommand}" Padding="12,6" Margin="0,0,8,4" />
        </WrapPanel>

        <!-- 第二行：纯 Command 绑定快捷跳页与自动连跳压测 -->
        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="跳至第 1 行" Command="{Binding JumpFirstCommand}" Padding="10,5" Margin="0,0,8,4" />
            <Button Content="跳至第 50 万行" Command="{Binding Jump500KCommand}" Padding="10,5" Margin="0,0,8,4" />
            <Button Content="跳至中点行" Command="{Binding JumpMiddleCommand}" Padding="10,5" Margin="0,0,8,4" />
            <Button Content="跳至末尾页" Command="{Binding JumpEndCommand}" Padding="10,5" Margin="0,0,8,4" />
            <Button Content="随机跳页" Command="{Binding JumpRandomCommand}" Padding="10,5" Margin="0,0,8,4" />
            <Button Style="{DynamicResource LightExcel.PrimaryButtonStyle}" Content="连跳 20 页演示 LRU 淘汰"
                    Command="{Binding Sweep20PagesCommand}" Padding="12,5" Margin="0,0,12,4" />
            <TextBlock Text="{Binding ActionHint}" Foreground="{DynamicResource LightExcel.Muted}" VerticalAlignment="Center" Margin="0,0,0,4" />
        </WrapPanel>

        <!-- 第三行：纯数据绑定实时 LRU 监控仪表盘 -->
        <Border DockPanel.Dock="Top" Background="#102F50" BorderBrush="{DynamicResource LightExcel.Border}"
                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Foreground="{DynamicResource LightExcel.Text}" Margin="0,0,20,0" VerticalAlignment="Center">
                    <Run Text="总规模：" Foreground="{DynamicResource LightExcel.Muted}" />
                    <Run FontWeight="SemiBold" Text="{Binding TotalRowsText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Foreground="{DynamicResource LightExcel.Text}" Margin="0,0,20,0" VerticalAlignment="Center">
                    <Run Text="LRU 常驻页：" Foreground="{DynamicResource LightExcel.Muted}" />
                    <Run FontWeight="SemiBold" Foreground="#38BDF8" Text="{Binding ResidentPagesText, Mode=OneWay}" />
                    <Run Foreground="{DynamicResource LightExcel.Muted}" Text="{Binding PeakPagesText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Foreground="{DynamicResource LightExcel.Text}" Margin="0,0,20,0" VerticalAlignment="Center">
                    <Run Text="累计加载页：" Foreground="{DynamicResource LightExcel.Muted}" />
                    <Run FontWeight="SemiBold" Foreground="#22C55E" Text="{Binding LoadedPagesText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Foreground="{DynamicResource LightExcel.Text}" Margin="0,0,20,0" VerticalAlignment="Center">
                    <Run Text="LRU 已淘汰冷页：" Foreground="{DynamicResource LightExcel.Muted}" />
                    <Run FontWeight="SemiBold" Foreground="#FB923C" Text="{Binding EvictedPagesText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Foreground="{DynamicResource LightExcel.Text}" Margin="0,0,20,0" VerticalAlignment="Center">
                    <Run Text="在途/已取消：" Foreground="{DynamicResource LightExcel.Muted}" />
                    <Run FontWeight="SemiBold" Text="{Binding InFlightText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Foreground="{DynamicResource LightExcel.Text}" Margin="0,0,20,0" VerticalAlignment="Center">
                    <Run Text="分页缓存估算：" Foreground="{DynamicResource LightExcel.Muted}" />
                    <Run FontWeight="SemiBold" Foreground="#C084FC" Text="{Binding ResidentBytesText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Foreground="{DynamicResource LightExcel.Text}" VerticalAlignment="Center">
                    <Run Text="后端实读：" Foreground="{DynamicResource LightExcel.Muted}" />
                    <Run FontWeight="SemiBold" Text="{Binding BackendReadsText, Mode=OneWay}" />
                </TextBlock>
            </WrapPanel>
        </Border>

        <!-- 底部：后端实际读页轨迹与验证步骤提示 -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock Foreground="{DynamicResource LightExcel.Text}" TextWrapping="Wrap" Margin="0,0,0,4">
                <Run Text="最近后端实际读页轨迹：" Foreground="{DynamicResource LightExcel.Muted}" />
                <Run Foreground="#38BDF8" Text="{Binding RecentPagesText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Foreground="{DynamicResource LightExcel.Muted}" TextWrapping="Wrap"
                       Text="验证 LRU 命中与淘汰：先点「跳至第 1 行」再点「跳至第 50 万行」，再点回「跳至第 1 行」——“后端实读”次数完全不变（LRU 缓存命中、0ms 秒开）；点「连跳 20 页演示 LRU 淘汰」后，“LRU 已淘汰冷页”持续上升而“LRU 常驻页”始终封顶、内存恒定不涨，此时再跳回第 1 行才会重新触发后端读取。" />
        </StackPanel>

        <!-- 表格主区域：纯 XAML 绑定 DataSource + FirstVisibleRow，零 code-behind 胶水 -->
        <Border Background="{DynamicResource LightExcel.Surface}" BorderBrush="{DynamicResource LightExcel.Border}"
                BorderThickness="1" CornerRadius="10" Padding="1">
            <sheet:SpreadsheetVisual DataSource="{Binding PagedSource}"
                                     FirstVisibleRow="{Binding CurrentFirstRow, Mode=TwoWay}"
                                     IsLayoutPersistenceEnabled="False"
                                     IsReadOnly="True"
                                     FrozenColumnCount="2"
                                     CornerRadius="9"
                                     CanUserCopyPaste="True"
                                     CanUserSortColumns="False"
                                     CanUserFilterColumns="False">
                <sheet:SpreadsheetVisual.Columns>
                    <sheet:SheetColumn Header="订单号" Width="145" />
                    <sheet:SheetColumn Header="所属页号" Width="115" />
                    <sheet:SheetColumn Header="行序号" Width="110" />
                    <sheet:SheetColumn Header="订单日期" Width="110" />
                    <sheet:SheetColumn Header="客户行业" Width="105" />
                    <sheet:SheetColumn Header="客户名称" Width="130" />
                    <sheet:SheetColumn Header="产品名称" Width="130" />
                    <sheet:SheetColumn Header="订单状态" Width="95" />
                    <sheet:SheetColumn Header="生产厂区" Width="95" />
                    <sheet:SheetColumn Header="优先级" Width="80" />
                    <sheet:SheetColumn Header="数量" Width="90" />
                    <sheet:SheetColumn Header="金额(元)" Width="115" />
                </sheet:SpreadsheetVisual.Columns>
                <sheet:SpreadsheetVisual.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Height" Value="34" />
                        <Setter Property="FontSize" Value="14" />
                    </Style>
                </sheet:SpreadsheetVisual.ColumnHeaderStyle>
                <sheet:SpreadsheetVisual.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="27" />
                        <Setter Property="FontSize" Value="14" />
                    </Style>
                </sheet:SpreadsheetVisual.RowStyle>
            </sheet:SpreadsheetVisual>
        </Border>
    </DockPanel>
</UserControl>
